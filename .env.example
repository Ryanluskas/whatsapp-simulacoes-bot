# ===========================================================================
#  LEGIO — configuração do sistema de simulações
#  Copie para .env e ajuste. O iniciar.bat faz essa cópia sozinho se faltar.
# ===========================================================================

# --- Onde a simulação roda --------------------------------------------------
# local  = a automação do Santander roda NESTE processo (Windows, com o Brave).
# remote = a fila fica aqui e um agente externo executa (use com Docker).
#          Nesse modo, rode no Windows:  python agente.py
SIMULATOR_MODE=local
# Segredo compartilhado entre o painel e o agente. Obrigatório em modo remote.
# Gere um valor longo e aleatório e use o MESMO nos dois lados.
AGENT_TOKEN=
# Endereço do painel, usado pelo agente (só no Windows).
PANEL_URL=http://127.0.0.1:8000

# --- Simulador (projeto Arqueiro) ------------------------------------------
# Pasta onde está o bot.py original. A lógica de simulação NÃO é reescrita:
# este projeto importa e chama as funções de lá.
SIM_BOT_PATH=C:\Users\Ryyan\Downloads\arqueiro
SIMULATOR_PROFILE_DIR=.simulator-profile
SIMULATOR_ENABLED=true
# Tempo máximo de uma simulação antes de ser dada como travada (segundos).
JOB_TIMEOUT_SECONDS=300
# Tentativas por solicitação. Só erros recuperáveis (timeout, queda de rede,
# sessão expirada) são repetidos; erro de dados não é.
MAX_ATTEMPTS=2
# Telefone usado quando o consultor não informa nenhum. O bot do Arqueiro tem
# um placeholder próprio, mas monta o DDD como "00" com o campo vazio e o
# portal recusa esse DDD.
DEFAULT_PHONE=11999998888
# Deixe vazio para achar o Brave sozinho (e cair no Chromium do Playwright se
# não houver Brave). O MESMO navegador é usado pelo WhatsApp e pelo simulador:
# um perfil copiado do Brave precisa ser aberto pelo Brave para as senhas
# salvas serem lidas.
BROWSER_EXECUTABLE=

# --- Perfis do navegador ----------------------------------------------------
# Cada serviço precisa do SEU diretório: o Chromium tranca o perfil, e dois
# navegadores no mesmo diretório não sobem (o segundo morre com "Target page,
# context or browser has been closed").
#
# Para que os dois nasçam com as suas senhas e sessões do Brave, rode:
#     sincronizar_perfis.ps1          (com o Brave FECHADO)
# Ele copia o seu perfil para os dois diretórios abaixo. Rode de novo sempre
# que trocar a senha do Santander ou refazer o login no seu Brave.

# --- WhatsApp ---------------------------------------------------------------
# Nome EXATO do grupo, como aparece na lista de conversas.
# Se ficar vazio, o bot usa a conversa que estiver aberta na tela.
# --- Camada de WhatsApp -------------------------------------------------------
# dom       = dirige o WhatsApp Web no navegador e le' o HTML (o jeito antigo)
# evolution = fala a Evolution API (citar e mandar imagem viram campos de JSON)
#
# Troque para 'evolution' SO' depois de validar num grupo de teste. O modo
# 'dom' continua funcionando e e' o plano de retorno.
WHATSAPP_MODE=dom

# So' usados quando WHATSAPP_MODE=evolution.
EVOLUTION_URL=http://localhost:8080
# Segredo. Nunca vai para log, nunca aparece no painel, nunca no git.
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=allana
# O JID do grupo, no formato 120363XXXXXXXX@g.us -- NAO e' o nome.
# Descubra com:  .venv/Scripts/python.exe -m app.evolution_check
EVOLUTION_GROUP_JID=
# Segredo compartilhado que autentica o POST /webhook/whatsapp. Sem ele a rota
# fica aberta para qualquer um injetar mensagem no bot. Gere um valor longo:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
EVOLUTION_WEBHOOK_TOKEN=

# O NOME DO PERFIL da conta do WhatsApp que o bot usa.
#
# Onde conferir: no celular do bot, Configuracoes -> seu perfil (o nome que
# aparece no topo). NAO e' "algum nome que aparece no grupo" -- os autores
# visiveis numa conversa sao os CONSULTORES.
#
# A comparacao de autoria e' conclusiva nos dois sentidos, e errar custa caro
# de dois jeitos diferentes:
#
#   * nome errado -> o bot nao reconhece as proprias respostas e pode
#     trata-las como pedidos novos (risco de laco);
#   * nome de um CONSULTOR aqui -> o bot passa a ignorar TODOS os pedidos
#     dessa pessoa, em silencio, e ninguem descobre por que.
#
# O segundo erro quase entrou: um autor visivel no grupo foi confundido com a
# assinatura do bot. Autor de mensagem recebida nunca e' o bot.
BOT_SELF_NAME=Operacional Capital

# --- Alarmes da fila ---------------------------------------------------------
# Sao dois problemas diferentes, com limiares separados:
#   fila grande  -> enxurrada: normal, so' demora
#   espera longa -> travamento: nao e' normal
#
# Em 01/09 o grupo mandou 59 mensagens em 2 minutos, viraram 50 solicitacoes,
# o bot respondeu UMA e o WhatsApp caiu. Quarenta e nove consultores ficaram
# esperando e nada na tela dizia isso.
ALERTA_FILA=10
ALERTA_ESPERA_MINUTOS=5

WHATSAPP_GROUP_NAME=Nome do grupo dos consultores
WHATSAPP_PROFILE_DIR=.whatsapp-profile
# headless=false é o recomendado: você vê o QR Code e o que o bot está fazendo.
WHATSAPP_HEADLESS=false
# O gatilho natural é o CPF: mensagem com CPF válido é pedido, o resto é
# conversa. Ligue (true) só se quiser exigir a palavra "fazer simulação".
REQUIRE_TRIGGER=false
# Intervalo de leitura de novas mensagens, em segundos.
POLL_SECONDS=3
# Responde citando a mensagem original do consultor, quando o WhatsApp permite.
REPLY_QUOTE=true
# Responde com a IMAGEM dos cards de contrato + quanto libera, no lugar do texto
# puro. Se a imagem falhar por qualquer motivo, o bot cai para texto sozinho —
# o consultor nunca fica sem resposta.
SEND_RESULT_IMAGE=true
# Nome e CPF do cliente sem máscara DENTRO DA IMAGEM enviada ao grupo.
# É uma chave separada de MASK_CPF_IN_UI de propósito: o painel e o grupo são
# públicos diferentes. Deixe false para enviar o CPF mascarado.
IMAGE_SHOW_CLIENT_DATA=true

# --- Regras de negócio ------------------------------------------------------
SUPPORTED_BANKS=Santander
# WORKER_COUNT=1 é intencional: a automação do Santander usa uma sessão de
# navegador só, e duas simulações na mesma página se atropelam. A FILA aceita
# quantos pedidos simultâneos vierem — o que é serial é o processamento.
# Acima de 1, cada worker abre um navegador e exige um login próprio.
WORKER_COUNT=1

# --- Painel -----------------------------------------------------------------
DB_PATH=simulacoes.db
STATE_PATH=state.json
# Pasta dos PNGs enviados (comprovantes/REQ000123.png). Vazio = ./comprovantes
# COMPROVANTES_DIR=
WEB_HOST=127.0.0.1
WEB_PORT=8000
# TROQUE ESTA SENHA.
# REGRA DE PARTIDA: com WEB_HOST fora de 127.0.0.1 (o caso do Docker), o
# sistema RECUSA subir com senha fraca/padrao, SESSION_SECRET vazio ou
# placeholder, e -- conforme o modo -- EVOLUTION_WEBHOOK_TOKEN ou
# AGENT_TOKEN curtos. Em 127.0.0.1 os defaults passam, com aviso no log.
DASHBOARD_PASSWORD=admin
# Segredo que assina os cookies de sessão. Gere um valor longo e aleatório;
# trocá-lo desloga todo mundo. Se ficar vazio, um segredo novo é sorteado a
# cada reinício (e as sessões caem junto).
SESSION_SECRET=troque-por-um-valor-longo-e-aleatorio
SESSION_HOURS=12
# true = o CPF sai mascarado da API, do painel e dos relatórios exportados.
MASK_CPF_IN_UI=true
TIMEZONE=America/Sao_Paulo
# Dias de retenção de logs e eventos do monitor.
RETENTION_DAYS=180
